{
  "name": "ascras",
  "version": "0.1.0",
  "private": true,
  "description": "ASCRAS \u2014 Automated Sales Call Review and Analysis System",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./landing\" --filter \"./portal\" --filter \"./admin\" --filter \"./backend\" dev",
    "dev:landing": "pnpm --filter landing dev",
    "dev:portal": "pnpm --filter portal dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:backend": "pnpm --filter backend start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r exec tsc --noEmit"
  }
}